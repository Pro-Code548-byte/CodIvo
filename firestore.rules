rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow write: if true;
    }

    match /duels/{code} {
      allow read, write: if true;

      match /actions/{actionId} {
        allow read, write: if true;
      }
    }
  }
}